<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.canvas.*?>
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.MainController"
            style="-fx-background-color: #1e1e2e;">
   <center>
      <StackPane fx:id="mapPane"
                 style="-fx-background-color: #13131f; -fx-border-color: #3a3a5c; -fx-border-width: 1;">
         <ImageView fx:id="mapImageView" preserveRatio="true"/>
         <Canvas fx:id="mapCanvas" width="700" height="500"/>
      </StackPane>
   </center>
   <right>
      <VBox spacing="0"
            prefWidth="260"
            style="-fx-background-color: #252535; -fx-border-color: #3a3a5c; -fx-border-width: 0 0 0 1;">
         <VBox style="-fx-background-color: #2e2e45; -fx-padding: 14 16 14 16;">
            <Label text="National Gallery"
                   style="-fx-text-fill: #e8e8f0; -fx-font-size: 15px; -fx-font-weight: bold;"/>
            <Label text="Route Finder"
                   style="-fx-text-fill: #8888aa; -fx-font-size: 11px;"/>
         </VBox>
         <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
            <VBox spacing="0">

               <VBox style="-fx-padding: 14 16 8 16; -fx-background-color: #252535;">
                  <Label text="ROUTE SETUP"
                         style="-fx-text-fill: #6666aa; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 0 0 8 0;"/>

                  <Label text="Start Room" style="-fx-text-fill: #aaaacc; -fx-font-size: 11px; -fx-padding: 0 0 3 0;"/>
                  <ComboBox fx:id="startRoomCombo" maxWidth="Infinity"
                            style="-fx-background-color: #1e1e2e; -fx-text-fill: #e8e8f0; -fx-border-color: #3a3a5c; -fx-border-radius: 4; -fx-background-radius: 4;"/>

                  <Label text="Destination Room" style="-fx-text-fill: #aaaacc; -fx-font-size: 11px; -fx-padding: 10 0 3 0;"/>
                  <ComboBox fx:id="destRoomCombo" maxWidth="Infinity"
                            style="-fx-background-color: #1e1e2e; -fx-text-fill: #e8e8f0; -fx-border-color: #3a3a5c; -fx-border-radius: 4; -fx-background-radius: 4;"/>

                  <Label text="Waypoints" style="-fx-text-fill: #aaaacc; -fx-font-size: 11px; -fx-padding: 10 0 3 0;"/>
                  <TextField fx:id="waypointsField" promptText="e.g. 5, 10, 15"
                             style="-fx-background-color: #1e1e2e; -fx-text-fill: #e8e8f0; -fx-prompt-text-fill: #55557a; -fx-border-color: #3a3a5c; -fx-border-radius: 4; -fx-background-radius: 4;"/>

                  <Label text="Rooms to Avoid " style="-fx-text-fill: #aaaacc; -fx-font-size: 11px; -fx-padding: 10 0 3 0;"/>
                  <TextField fx:id="avoidRoomsField" promptText="e.g. 5, 10, 15"
                             style="-fx-background-color: #1e1e2e; -fx-text-fill: #e8e8f0; -fx-prompt-text-fill: #55557a; -fx-border-color: #3a3a5c; -fx-border-radius: 4; -fx-background-radius: 4;"/>
               </VBox>
               <Separator style="-fx-background-color: #3a3a5c;"/>
               <VBox style="-fx-padding: 14 16 8 16; -fx-background-color: #252535;">
                  <Label text="DFS OPTIONS"
                         style="-fx-text-fill: #6666aa; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 0 0 8 0;"/>

                  <Label text="Max Routes" style="-fx-text-fill: #aaaacc; -fx-font-size: 11px; -fx-padding: 0 0 3 0;"/>
                  <TextField fx:id="maxRoutesField" promptText="e.g. 5"
                             style="-fx-background-color: #1e1e2e; -fx-text-fill: #e8e8f0; -fx-prompt-text-fill: #55557a; -fx-border-color: #3a3a5c; -fx-border-radius: 4; -fx-background-radius: 4;"/>
               </VBox>
               <Separator style="-fx-background-color: #3a3a5c;"/>
               <VBox style="-fx-padding: 14 16 8 16; -fx-background-color: #252535;">
                  <Label text="DIJKSTRA OPTIONS"
                         style="-fx-text-fill: #6666aa; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 0 0 8 0;"/>

                  <Label text="Interested Artists" style="-fx-text-fill: #aaaacc; -fx-font-size: 11px; -fx-padding: 0 0 3 0;"/>
                  <TextField fx:id="artistsField" promptText="e.g. Vermeer, Monet"
                             style="-fx-background-color: #1e1e2e; -fx-text-fill: #e8e8f0; -fx-prompt-text-fill: #55557a; -fx-border-color: #3a3a5c; -fx-border-radius: 4; -fx-background-radius: 4;"/>
               </VBox>
               <Separator style="-fx-background-color: #3a3a5c;"/>
               <VBox spacing="8" style="-fx-padding: 14 16 14 16; -fx-background-color: #252535;">
                  <Label text="FIND ROUTE"
                         style="-fx-text-fill: #6666aa; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 0 0 4 0;"/>

                  <Button fx:id="dfsButton" text="Multiple Routes (DFS)" maxWidth="Infinity"
                          onAction="#runDFS"
                          style="-fx-background-color: #3d3d6b; -fx-text-fill: #c8c8ee; -fx-font-size: 12px; -fx-padding: 8 12; -fx-background-radius: 5; -fx-cursor: hand;"/>

                  <Button fx:id="dijkstraButton" text="Shortest Route (Dijkstra)" maxWidth="Infinity"
                          onAction="#runDijkstra"
                          style="-fx-background-color: #3d3d6b; -fx-text-fill: #c8c8ee; -fx-font-size: 12px; -fx-padding: 8 12; -fx-background-radius: 5; -fx-cursor: hand;"/>

                  <Button fx:id="interestingButton" text="Most Interesting Route" maxWidth="Infinity"
                          onAction="#runInteresting"
                          style="-fx-background-color: #3d3d6b; -fx-text-fill: #c8c8ee; -fx-font-size: 12px; -fx-padding: 8 12; -fx-background-radius: 5; -fx-cursor: hand;"/>

                  <Button fx:id="bfsButton" text="BFS Pixel Search" maxWidth="Infinity"
                          onAction="#runBFS"
                          style="-fx-background-color: #3d3d6b; -fx-text-fill: #c8c8ee; -fx-font-size: 12px; -fx-padding: 8 12; -fx-background-radius: 5; -fx-cursor: hand;"/>

                  <Button text="Clear Map" maxWidth="Infinity"
                          onAction="#clearCanvas"
                          style="-fx-background-color: #4a2a2a; -fx-text-fill: #e8aaaa; -fx-font-size: 12px; -fx-padding: 8 12; -fx-background-radius: 5; -fx-cursor: hand;"/>
               </VBox>
               <Separator style="-fx-background-color: #3a3a5c;"/>
               <VBox style="-fx-padding: 14 16 14 16; -fx-background-color: #252535;">
                  <Label text="RESULTS"
                         style="-fx-text-fill: #6666aa; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 0 0 8 0;"/>
                  <TextArea fx:id="resultsArea"
                            prefHeight="180"
                            editable="false"
                            wrapText="true"
                            style="-fx-control-inner-background: #1e1e2e; -fx-text-fill: #c8c8ee; -fx-font-size: 11px; -fx-border-color: #3a3a5c; -fx-border-radius: 4; -fx-background-radius: 4;"/>
               </VBox>
            </VBox>
         </ScrollPane>
      </VBox>
   </right>
</BorderPane>
